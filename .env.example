# You need TAVILY_API_KEY plus ONE model key (Gemini OR Anthropic).

# --- Search (required) --------------------------------------------------
# Tavily: https://app.tavily.com/  (free plan: 1,000 credits/month, no credit card)
TAVILY_API_KEY=

# --- Model: option A, free (recommended) ---------------------------------
# Google AI Studio: https://aistudio.google.com/apikey  (free tier, no credit card)
GEMINI_API_KEY=

# --- Model: option B, paid/credit-based ---------------------------------
# Anthropic: https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# --- Optional ------------------------------------------------------------
# Force a provider ("gemini" or "anthropic"). Default: Gemini if its key is set, else Anthropic.
# PROVIDER=gemini

# Main model that talks to the user. Defaults: gemini-3.5-flash-lite / claude-sonnet-5-5.
# Free-tier tip: Flash-Lite has a far higher daily request cap than Flash; use
# MODEL=gemini-3.8-flash for better answers if you have the quota.
# MODEL=

# Small, fast model that writes memory digests after each turn (off the hot path).
# LEDGER_MODEL=

# Fallback time zone when the browser does not send one (IANA name).
# DEFAULT_TZ=Asia/Kolkata

# PORT=3000

# Where the conversation ledger (memory) lives.
# DATA_DIR=./data
